# Application
NODE_ENV=production

# Backend
BACKEND_PORT=4000

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=procurement
VITE_KEYCLOAK_CLIENT_ID=procurement-frontend

# MongoDB
MONGODB_URI=mongodb://admin:password@mongodb:27017/procurement?authSource=admin
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password
MONGODB_DATABASE=procurement

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=procurement
KEYCLOAK_CLIENT_ID=procurement-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

# Docker registry (for CD)
REGISTRY=ghcr.io
IMAGE_NAME=your-org/procurement
